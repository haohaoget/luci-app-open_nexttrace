{
  "luci-app-open_nexttrace": {
    "description": "View and run bounded NextTrace diagnostics",
    "read": {
      "ubus": { "open_nexttrace": ["info", "status"] },
      "uci": ["open_nexttrace"]
    },
    "write": {
      "ubus": { "open_nexttrace": ["start", "stop"] },
      "uci": ["open_nexttrace"]
    }
  }
}
